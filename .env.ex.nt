# ==========================================================
#  AI x IP-MPLS Workshop - SAMPLE: NT servers
#  LLM, embedding and rerank on the NT servers (plain http, inside the network).
#  Use:  cp .env.ex.nt .env   then put the embedding server's key in EMBEDDING_API_KEY.
#  The LLM server needs no key; the LLM model thinks before answering, so replies
#  are slower than on OpenRouter (seconds to minutes per question).
# ==========================================================

# ---------- LLM (OpenAI-compatible endpoint) ----------
# Default: OpenRouter. Point instead to Ollama, vLLM, or the internal
# corporate LLM gateway if you prefer a local/self-hosted model.
LLM_BASE_URL=http://1.179.140.78:8080/v1
# This server needs no key. Do NOT put an OpenRouter key here: it would be sent
# over plain http. Any placeholder works.
LLM_API_KEY=not-needed
LLM_MODEL=Qwen/Qwen3.8-27B
# Smaller model for fast iteration during labs.
LLM_MODEL_FAST=Qwen/Qwen3.8-27B
LLM_TIMEOUT_SECONDS=120
# Force JSON Schema output (guided decoding). Verify the gateway supports it.
LLM_GUIDED_DECODING=true
# Switch a reasoning model's "thinking" phase off (sends enable_thinking=false with every request).
# Much faster on Qwen3-style models served by vLLM. Keep true for OpenRouter and other gateways.
LLM_ENABLE_THINKING=false

# ---------- Embedding ----------
EMBEDDING_BASE_URL=http://209.15.120.6:8001/v1
# Key of the embedding server (different from the LLM server). Fill in locally.
EMBEDDING_API_KEY=
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024

# ---------- Rerank ----------
# Same server as embedding for now (endpoint /v1/rerank, no key needed).
RERANK_BASE_URL=http://209.15.120.6:8001/v1
RERANK_MODEL=bge-m3
RERANK_TOP_K=5
RETRIEVE_TOP_K=50

# ---------- PostgreSQL (tickets + configs) ----------
PG_HOST=postgres
PG_PORT=5432
PG_DATABASE=mplsdb
PG_USER=mpls
PG_PASSWORD=mpls_dev_password
# Read-only user. The MCP server must use ONLY this account.
PG_READONLY_USER=mcp_reader
PG_READONLY_PASSWORD=mcp_reader_password
PG_DSN=postgresql://mcp_reader:mcp_reader_password@localhost:5432/mplsdb

# ---------- pgAdmin ----------
PGADMIN_EMAIL=workshop@example.com
PGADMIN_PASSWORD=workshop

# ---------- Neo4j (topology) ----------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_dev_password
NEO4J_DATABASE=neo4j

# ---------- OpenSearch (logs + vectors) ----------
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_LOG_INDEX=network-logs
OPENSEARCH_DOC_INDEX=network-docs
OPENSEARCH_USER=
OPENSEARCH_PASSWORD=

# ---------- MCP server ----------
# Name shown in the Claude Desktop / Cursor server list.
MCP_SERVER_NAME=nt-network
MCP_SERVER_URL=http://localhost:9000/mcp
MCP_TRANSPORT=streamable-http
# Guardrails
MCP_MAX_ROWS=200
MCP_MAX_LOG_RESULTS=50
MCP_QUERY_TIMEOUT_SECONDS=15

# ---------- Agent API / UI ----------
AGENT_API_URL=http://localhost:8080
AGENT_API_PORT=8080
CHAINLIT_PORT=8000
AGENT_MAX_STEPS=8
AGENT_MAX_SAME_TOOL_CALLS=3
MEMORY_TOPIC_SHIFT_THRESHOLD=0.3
MEMORY_WINDOW_TURNS=6

# ---------- Notification ----------
NOTIFIER_BACKEND=mailhog
SMTP_HOST=localhost
SMTP_PORT=1025
NOTIFY_TO=noc@example.local
TELEGRAM_MOCK_URL=http://localhost:8099/telegram

# ---------- Time (keeps data independent of the wall clock) ----------
# Empty: "now" is derived from the newest log timestamp in OpenSearch.
# Set an ISO8601 value to freeze time (used by tests for reproducibility).
DEMO_NOW=
# Deterministic seeding so the dataset is identical on every run.
SEED_RANDOM_SEED=42
SEED_DAYS_BACK=30

# ---------- Demo container ----------
DEMO_MODE=live
PRESENTER_MODE=true
READ_ONLY=true
